# Copy to .env at repository root. No keys needed for the local synthetic demo.
# NEVER commit the resulting .env. Names only in this file.
DATABASE_URL=sqlite:///./data/vitalis.db
DATA_DIR=./data
DEMO_MODE=true
SIMULATOR_AUTOSTART=true
SIMULATOR_INTERVAL_SECONDS=2

# Required when DEMO_MODE=false; use a long random value. Never NEXT_PUBLIC_.
API_TOKEN=

# Next.js server-side proxy only
BACKEND_URL=http://127.0.0.1:8000

# Legacy Basic-Auth gate for the single-clinician synthetic demo. Optional locally.
VITALIS_ACCESS_USER=doctor
VITALIS_ACCESS_PASSWORD=

# ---------------------------------------------------------------------------
# Cloud Postgres for the v1 (authenticated) platform.
# Cloud form: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Apply supabase/migrations/*.sql in order before using PostgreSQL.
# Existing hosted migration versions differ: reconcile history first; see docs/SECURITY_VERIFICATION.md.
PLATFORM_DATABASE_URL=
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase (frontend + backend). Get these from your Supabase project settings.
#   * URL / anon key:            Project Settings -> API
#   * Service role key (SECRET): Project Settings -> API (server only!)
#   * JWT secret (SECRET):       Project Settings -> API -> JWT Settings
# NEXT_PUBLIC_* is exposed to the browser -- never put service_role or jwt_secret there.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Test-only: used by the Playwright auth fixture to create disposable users.
# Do NOT set this in a production frontend deployment.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Site URL used to build the OAuth redirect target. Include scheme + host + port.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: comma-separated allowlist of emails permitted to sign in (backend enforcement).
VITALIS_ALLOWED_EMAILS=

# Explicit comma-separated browser origins; no wildcard. Empty disables cross-origin access.
# Local example: http://localhost:3000,http://127.0.0.1:3000
VITALIS_CORS_ORIGINS=
# ---------------------------------------------------------------------------
# Rate limiting.
#
# Limits are per-client. The client is the ASGI peer address by default -- but
# in production every request arrives via the Next.js proxy, so that default
# collapses every caller into ONE global bucket. Set the same secret here and
# in the Vercel project to let the proxy declare the real client address; the
# backend honours a declared identity only when this secret verifies, so no
# untrusted caller can pick its own bucket with a header.
# Only enable this when the web tier sits behind a trusted edge that
# overwrites X-Forwarded-For (Vercel does). See docs/DEPLOYMENT.md.
VITALIS_PROXY_SECRET=
#
# Optional per-process, per-client limits per minute. Leave unset for the
# defaults shown; configure numeric values when setting them.
# VITALIS_AUTH_RATE_LIMIT           (default 120)  /api/v1/me
# VITALIS_READ_RATE_LIMIT           (default 600)  other /api/v1/** reads
# VITALIS_UPLOAD_RATE_LIMIT         (default 20)   document uploads
# VITALIS_MUTATION_RATE_LIMIT       (default 120)  other /api/** writes
# Wearable ingestion has its own budget so continuous streaming never shares
# the general write allowance: one handset at the documented ~2s cadence is
# already 30 writes/minute.
# VITALIS_BRIDGE_VITALS_RATE_LIMIT  (default 60)   POST /api/v1/bridge/vitals
# Attempts per minute, per client, against POST /api/v1/bridge/pair.
# Bridge Codes are permanent, so this is the primary brute-force bound; keep it
# low. See docs/BRIDGE.md.
# VITALIS_BRIDGE_PAIR_RATE_LIMIT    (default 10)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Google OAuth is configured in the Supabase dashboard, not in this env file.
# See docs/AUTH.md for the exact Google Cloud Console + Supabase Auth steps.
# ---------------------------------------------------------------------------
